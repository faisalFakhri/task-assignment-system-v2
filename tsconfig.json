{
  "compilerOptions": {
    "lib": ["es2022", "dom", "dom.iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["vite.config.mts", "src/**/*.{ts,tsx}"]
}
